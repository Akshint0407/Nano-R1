BASE_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
LORA_ADAPTER_PATH=grpo_saved_lora
MAX_SEQ_LENGTH=1024
MAX_NEW_TOKENS=512
LOAD_IN_4BIT=true
GPU_MEMORY_UTILIZATION=0.5
# Set to true on machines without a GPU (local dev, CI) to serve canned responses.
USE_STUB_MODEL=true
# Shared secret — must match INFERENCE_API_KEY used by apps/api
INFERENCE_API_KEY=change-me
PORT=8001
